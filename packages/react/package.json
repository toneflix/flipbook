{
  "name": "@toneflix/flipbook-react",
  "version": "0.1.0",
  "description": "A photo book for React: peel-and-fold page turns, printed photos, frames and paper textures.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/toneflix/flipbook",
    "directory": "packages/react"
  },
  "keywords": [
    "flipbook",
    "page turn",
    "photo book",
    "react",
    "page curl"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./textures/*": "./dist/textures/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && cp ../vanilla/src/style.css dist/ && mkdir -p dist/textures && cp ../core/textures/*.webp dist/textures/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@toneflix/flipbook-core": "workspace:^",
    "@toneflix/flipbook": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.5",
    "typescript": "~6.0.3"
  }
}
