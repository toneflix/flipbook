{
  "name": "@toneflix/flipbook",
  "version": "0.1.0",
  "description": "A photo book for any web page, no framework needed: peel-and-fold page turns, printed photos, frames and paper textures.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/toneflix/flipbook",
    "directory": "packages/vanilla"
  },
  "keywords": [
    "flipbook",
    "page turn",
    "photo book",
    "page curl",
    "vanilla"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/flipbook.iife.js",
  "jsdelivr": "./dist/flipbook.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./textures/*": "./dist/textures/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && cp src/style.css dist/ && mkdir -p dist/textures && cp ../core/textures/*.webp dist/textures/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@toneflix/flipbook-core": "workspace:^"
  },
  "devDependencies": {
    "tsdown": "^0.23.5",
    "typescript": "~6.0.3"
  }
}
