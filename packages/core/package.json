{
  "name": "@toneflix/flipbook-core",
  "version": "0.1.0",
  "description": "Page-turn physics and book model behind Toneflix Flipbook. Framework free.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/toneflix/flipbook",
    "directory": "packages/core"
  },
  "keywords": [
    "flipbook",
    "page turn",
    "photo book",
    "page curl"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./textures/*": "./textures/*"
  },
  "files": [
    "dist",
    "textures"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.23.5",
    "vitest": "^3.2.7",
    "typescript": "~6.0.3"
  }
}
