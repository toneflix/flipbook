{
  "name": "toneflix-flipbook",
  "private": true,
  "description": "A photo book you can hold: peel-and-fold page turns, printed photos and paper textures for React and React Native.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm build && pnpm --filter docs build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
